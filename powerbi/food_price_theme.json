{
  "name": "Food Price Monitor",
  "dataColors": ["#1B6B5A", "#E07A2E", "#3A7BD5", "#8E5BB5", "#D6457A", "#7A8B99", "#C9A227", "#2F9E8F"],
  "background": "#FFFFFF",
  "foreground": "#1F2A30",
  "tableAccent": "#1B6B5A",
  "good": "#1B8A5A",
  "neutral": "#C9A227",
  "bad": "#C8412B",
  "maximum": "#C8412B",
  "center": "#F4F1EA",
  "minimum": "#1B8A5A",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A30" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2A30" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#51606B" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2A30" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9E4D8" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2DCCD" } }, "radius": 12 }],
        "dropShadow": [{ "show": true, "preset": "Custom", "color": { "solid": { "color": "#1F2A30" } }, "transparency": 88, "shadowBlur": 10, "shadowDistance": 2, "angle": 90, "position": "Outer" }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "actionButton": {
      "*": {
        "dropShadow": [{ "show": false }]
      }
    },
    "pageNavigator": {
      "*": {
        "dropShadow": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    }
  }
}
